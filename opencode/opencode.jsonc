{
    "$schema": "https://opencode.ai/config.json",
    "model": "openai/gpt-5.6-luna",
    "permissions": [
        {
            "action": "read",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "edit",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "glob",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "subagent",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "skill",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "question",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "websearch",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "experimental_image_generate",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "deny"
        },
        {
            "action": "execute",
            "resource": "*",
            "effect": "ask"
        }
    ],
    "watcher": {
        "ignore": [
            ".opencode/**",
            ".git/**",
            "node_modules/**",
            "dist/**",
            "build/**"
        ]
    }
}
