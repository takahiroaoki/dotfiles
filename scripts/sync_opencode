#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_dir=$(CDPATH= cd -- "$script_dir/.." && pwd)

opencode="$repo_dir/agent/agents/opencode"
dist="$opencode/dist"
tmp_dist=$(mktemp -d "$opencode/.dist.XXXXXX")
trap 'rm -rf "$tmp_dist"' EXIT HUP INT TERM

for body in "$repo_dir"/agent/agents/*.body.md; do
    name=${body##*/}
    name=${name%.body.md}
    frontmatter="$opencode/$name.frontmatter.yml"
    output="$tmp_dist/$name.md"

    if [ -f "$frontmatter" ]; then
        cat "$frontmatter" "$body" > "$output"
        echo "Generated $output"
    else
        echo "Skip $name: missing $frontmatter"
    fi
done

rm -rf "$dist"
mv "$tmp_dist" "$dist"
trap - EXIT HUP INT TERM
